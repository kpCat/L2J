// REFERENCE ONLY — integrate into PhantomNativeWorkScope after E01 RED.
// No scheduler, SQL, I/O or change to EARNED semantics.
private static boolean isCastContinuationKind(String kind)
{
    return switch (kind)
    {
        case "cast-launch", "cast-hit", "cast-finalizer", "cast-delayed-finalizer",
             "cast-queued-skill", "cast-simultaneous-retry" -> true;
        default -> false;
    };
}

